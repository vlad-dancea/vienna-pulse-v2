{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vienna-pulse-frontend",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pulse.vladdancea.com/*",
      "zone_name": "vladdancea.com"
    },
    {
      "pattern": "pulse.vladdancea.com",
      "zone_name": "vladdancea.com",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true
    }
  ],
  "assets": {
    "directory": "./dist/vienna-pulse-frontend/browser",
    "not_found_handling": "single-page-application"
  }
}
