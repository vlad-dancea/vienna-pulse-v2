{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vienna-pulse-frontend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pulse.vladdancea.com/*",
      "zone_name": "vladdancea.com"
    }
  ],
  "assets": {
    "directory": "./dist/vienna-pulse-frontend/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
