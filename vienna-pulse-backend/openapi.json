{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Vienna Pulse API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "https://pulse.vladdancea.com"
  } ],
  "paths" : {
    "/api/lines" : {
      "get" : {
        "operationId" : "lines",
        "parameters" : [ {
          "in" : "query",
          "name" : "date",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionLineProperties"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionLineProperties"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "line-controller" ]
      }
    },
    "/api/stops" : {
      "get" : {
        "operationId" : "stops",
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionStopProperties"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionStopProperties"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "stop-controller" ]
      }
    },
    "/api/stops/{id}/departures" : {
      "get" : {
        "operationId" : "departures",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Departures"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "departure-controller" ]
      }
    },
    "/api/vehicles" : {
      "get" : {
        "operationId" : "vehicles",
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionVehicleProperties"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionVehicleProperties"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "vehicle-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Departure" : {
        "type" : "object",
        "properties" : {
          "headsign" : {
            "type" : [ "string", "null" ]
          },
          "line" : {
            "$ref" : "#/components/schemas/Line"
          },
          "platform" : {
            "type" : "string"
          },
          "time" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "headsign", "line", "platform", "time" ]
      },
      "Departures" : {
        "type" : "object",
        "properties" : {
          "departures" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Departure"
            }
          },
          "stop" : {
            "$ref" : "#/components/schemas/Stop"
          }
        },
        "required" : [ "departures", "stop" ]
      },
      "FeatureCollectionLineProperties" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeatureLineProperties"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "type" ]
      },
      "FeatureCollectionStopProperties" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeatureStopProperties"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "type" ]
      },
      "FeatureCollectionVehicleProperties" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeatureVehicleProperties"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "type" ]
      },
      "FeatureLineProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/MultiLineString"
            }, {
              "$ref" : "#/components/schemas/Point"
            } ]
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/LineProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "FeatureStopProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/MultiLineString"
            }, {
              "$ref" : "#/components/schemas/Point"
            } ]
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/StopProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "FeatureVehicleProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/MultiLineString"
            }, {
              "$ref" : "#/components/schemas/Point"
            } ]
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/VehicleProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "Geometry" : { },
      "Line" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "type" : "string"
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "id", "longName", "name", "textColor", "type" ]
      },
      "LineProperties" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "longName", "name", "textColor", "type" ]
      },
      "MultiLineString" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/Geometry"
        }, {
          "type" : "object",
          "properties" : {
            "coordinates" : {
              "type" : "array",
              "items" : {
                "type" : "array",
                "items" : {
                  "type" : "array",
                  "maxItems" : 2,
                  "minItems" : 2,
                  "prefixItems" : [ {
                    "type" : "number",
                    "format" : "double"
                  }, {
                    "type" : "number",
                    "format" : "double"
                  } ]
                }
              }
            },
            "type" : {
              "type" : "string",
              "const" : "MultiLineString"
            }
          }
        } ],
        "required" : [ "coordinates", "type" ]
      },
      "Point" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/Geometry"
        }, {
          "type" : "object",
          "properties" : {
            "coordinates" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            },
            "type" : {
              "type" : "string",
              "const" : "Point"
            }
          }
        } ],
        "required" : [ "coordinates", "type" ]
      },
      "Stop" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      },
      "StopProperties" : {
        "type" : "object",
        "properties" : {
          "modes" : {
            "type" : [ "array", "null" ],
            "items" : {
              "type" : "string"
            }
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "modes", "name" ]
      },
      "VehicleProperties" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "headsign" : {
            "type" : [ "string", "null" ]
          },
          "line" : {
            "type" : "string"
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "headsign", "line", "longName", "name", "textColor", "type" ]
      }
    }
  }
}
