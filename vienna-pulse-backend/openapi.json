{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Vienna Pulse API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "https://pulse-api.vladdancea.com"
  } ],
  "paths" : {
    "/api/lines" : {
      "get" : {
        "operationId" : "lines",
        "parameters" : [ {
          "in" : "query",
          "name" : "date",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionMultiLineStringLineProperties"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionMultiLineStringLineProperties"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The date is not a day written as YYYY-MM-DD."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "There is no timetable yet, or it does not cover the date."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Reading the timetable failed in a way no retry fixes."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The database did not answer in time. This passes on its own.",
            "headers" : {
              "Retry-After" : {
                "description" : "The seconds to wait before asking again.",
                "required" : true,
                "schema" : {
                  "type" : "integer"
                }
              }
            }
          }
        },
        "tags" : [ "line-controller" ]
      }
    },
    "/api/stops" : {
      "get" : {
        "operationId" : "stops",
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionPointStopProperties"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollectionPointStopProperties"
                }
              }
            },
            "description" : "OK"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Reading the timetable failed in a way no retry fixes."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The database did not answer in time. This passes on its own.",
            "headers" : {
              "Retry-After" : {
                "description" : "The seconds to wait before asking again.",
                "required" : true,
                "schema" : {
                  "type" : "integer"
                }
              }
            }
          }
        },
        "tags" : [ "stop-controller" ]
      }
    },
    "/api/stops/{id}/departures" : {
      "get" : {
        "operationId" : "departures",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Departures"
                }
              }
            },
            "description" : "OK"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "There is no stop with this id."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Reading the timetable failed in a way no retry fixes."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The database did not answer in time. This passes on its own.",
            "headers" : {
              "Retry-After" : {
                "description" : "The seconds to wait before asking again.",
                "required" : true,
                "schema" : {
                  "type" : "integer"
                }
              }
            }
          }
        },
        "tags" : [ "departure-controller" ]
      }
    },
    "/api/vehicles" : {
      "get" : {
        "operationId" : "vehicles",
        "responses" : {
          "200" : {
            "content" : {
              "application/geo+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Vehicles"
                }
              },
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Vehicles"
                }
              }
            },
            "description" : "OK"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Reading the timetable failed in a way no retry fixes."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The database did not answer in time. This passes on its own.",
            "headers" : {
              "Retry-After" : {
                "description" : "The seconds to wait before asking again.",
                "required" : true,
                "schema" : {
                  "type" : "integer"
                }
              }
            }
          }
        },
        "tags" : [ "vehicle-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Departure" : {
        "type" : "object",
        "properties" : {
          "headsign" : {
            "type" : [ "string", "null" ]
          },
          "line" : {
            "$ref" : "#/components/schemas/Line"
          },
          "liveTime" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "plannedTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "platform" : {
            "type" : "string"
          }
        },
        "required" : [ "headsign", "line", "liveTime", "plannedTime", "platform" ]
      },
      "Departures" : {
        "type" : "object",
        "properties" : {
          "departures" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Departure"
            }
          },
          "liveIn" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "liveStatus" : {
            "type" : "string",
            "enum" : [ "pending", "live", "unavailable" ]
          },
          "stop" : {
            "$ref" : "#/components/schemas/Stop"
          }
        },
        "required" : [ "departures", "liveIn", "liveStatus", "stop" ]
      },
      "FeatureCollectionMultiLineStringLineProperties" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeatureMultiLineStringLineProperties"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "type" ]
      },
      "FeatureCollectionPointStopProperties" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeaturePointStopProperties"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "type" ]
      },
      "FeatureMultiLineStringLineProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "$ref" : "#/components/schemas/MultiLineString"
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/LineProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "FeaturePointStopProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "$ref" : "#/components/schemas/Point"
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/StopProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "FeaturePointVehicleProperties" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "$ref" : "#/components/schemas/Point"
          },
          "id" : {
            "type" : "string"
          },
          "properties" : {
            "$ref" : "#/components/schemas/VehicleProperties"
          },
          "type" : {
            "type" : "string",
            "const" : "Feature"
          }
        },
        "required" : [ "geometry", "id", "properties", "type" ]
      },
      "Line" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "type" : "string"
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "id", "longName", "name", "textColor", "type" ]
      },
      "LineProperties" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "longName", "name", "textColor", "type" ]
      },
      "MultiLineString" : {
        "type" : "object",
        "properties" : {
          "coordinates" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "array",
                "maxItems" : 2,
                "minItems" : 2,
                "prefixItems" : [ {
                  "type" : "number",
                  "format" : "double"
                }, {
                  "type" : "number",
                  "format" : "double"
                } ]
              }
            }
          },
          "type" : {
            "type" : "string",
            "const" : "MultiLineString"
          }
        },
        "required" : [ "coordinates", "type" ]
      },
      "Point" : {
        "type" : "object",
        "properties" : {
          "coordinates" : {
            "type" : "array",
            "items" : {
              "type" : "number",
              "format" : "double"
            }
          },
          "type" : {
            "type" : "string",
            "const" : "Point"
          }
        },
        "required" : [ "coordinates", "type" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "An error as RFC 9457 describes it.",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "detail", "instance", "status", "title" ]
      },
      "Stop" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      },
      "StopProperties" : {
        "type" : "object",
        "properties" : {
          "modes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "modes", "name" ]
      },
      "VehicleProperties" : {
        "type" : "object",
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "headsign" : {
            "type" : [ "string", "null" ]
          },
          "line" : {
            "type" : "string"
          },
          "longName" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "path" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "maxItems" : 3,
              "minItems" : 3,
              "prefixItems" : [ {
                "type" : "number",
                "format" : "double"
              }, {
                "type" : "number",
                "format" : "double"
              }, {
                "type" : "number",
                "format" : "double"
              } ]
            }
          },
          "textColor" : {
            "type" : [ "string", "null" ]
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "color", "headsign", "line", "longName", "name", "path", "textColor", "type" ]
      },
      "Vehicles" : {
        "type" : "object",
        "properties" : {
          "features" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeaturePointVehicleProperties"
            }
          },
          "time" : {
            "type" : "string",
            "format" : "date-time"
          },
          "type" : {
            "type" : "string",
            "const" : "FeatureCollection"
          }
        },
        "required" : [ "features", "time", "type" ]
      }
    }
  }
}
